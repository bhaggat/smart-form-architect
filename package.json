{
  "name": "smart-form-architect",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.content.config.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "pack": "npm run build && cd dist && zip -r ../smartform-architect-release.zip *",
    "version:patch": "node scripts/update-version.js patch",
    "version:minor": "node scripts/update-version.js minor",
    "version:major": "node scripts/update-version.js major",
    "chrome:deploy": "node scripts/deploy-chrome.js",
    "chrome:publish": "node scripts/publish.js",
    "chrome:token": "node scripts/generate-token.js",
    "static:deploy": "./scripts/deploy-static.sh"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.1.37",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "chrome-types": "^0.1.420",
    "chrome-webstore-upload": "^3.0.0",
    "dotenv": "^16.4.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "open": "^10.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
